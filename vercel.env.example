# ============================================================
# SEPEDAETAM.TGR - Vercel deployment reference
# Set these as Environment Variables in Vercel Dashboard
# (Settings > Environment Variables). Do NOT commit real values.
# ============================================================

APP_NAME="Sepedaetam.tgr"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://your-app.vercel.app

# Generate on your machine: php artisan key:generate --show
APP_KEY=base64:xxxxxxxx

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# ---- Database (REQUIRED external MySQL / MariaDB) ----
# Vercel serverless has NO local DB. Use PlanetScale / Railway / Aiven / Hostinger.
DB_CONNECTION=mysql
DB_HOST=your-mysql-host
DB_PORT=3306
DB_DATABASE=your-db-name
DB_USERNAME=your-db-user
DB_PASSWORD=your-db-password
MYSQL_ATTR_SSL_CA=

# ---- Session & Cache (use DB - persists across serverless invocations) ----
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
CACHE_STORE=database
QUEUE_CONNECTION=sync

# ---- Logging (stderr = visible in Vercel function logs) ----
LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ---- Photo storage (optional but recommended) ----
# Local disk (FILESYSTEM_DISK=local) does NOT persist on serverless.
# For persistent bike photos use S3-compatible storage (S3/R2/MinIO).
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ---- Admin (seeded on first build) ----
ADMIN_PASSWORD=change-this-strong-password
